{
  "name": "@vhyxui/visual-runtime",
  "version": "0.1.0-alpha.1",
  "description": "VhyxUI visual runtime — evidence-scoped Structure/Runtime schema for stateful, animatable diagrams (v1 contract; Presentation layer not yet implemented)",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./structure": {
      "import": "./dist/structure.js",
      "require": "./dist/structure.cjs",
      "types": "./dist/structure.d.ts"
    },
    "./events": {
      "import": "./dist/events.js",
      "require": "./dist/events.cjs",
      "types": "./dist/events.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs",
      "types": "./dist/runtime.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@vhyxui/core": "workspace:*"
  }
}
