{
  "name": "@vhyxui/icons",
  "version": "0.2.0",
  "description": "SVG icons for VhyxUI: React components, framework-free SVG strings, a <vhyx-icon> web component and a sprite — token-driven sizes, built-in motion, zero runtime dependencies",
  "keywords": [
    "vhyxui",
    "vhyxara",
    "icons",
    "svg",
    "react",
    "web-components",
    "sprite",
    "design-tokens"
  ],
  "license": "MIT",
  "homepage": "https://vhyxui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vhyxara/vhyxUI.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/vhyxara/vhyxUI/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js",
      "require": "./dist/svg.js",
      "default": "./dist/svg.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./style.css": "./dist/style.css",
    "./sprite.svg": "./dist/sprite.svg",
    "./icons.json": "./dist/icons.json",
    "./icons/*.svg": "./icons/*.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "icons",
    "NOTICE"
  ],
  "scripts": {
    "import:lucide": "node scripts/import-lucide.mjs",
    "generate": "node scripts/build.mjs",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/build.mjs && tsc -p tsconfig.json && node scripts/build.mjs --assets",
    "test": "vitest run",
    "typecheck": "node scripts/build.mjs && tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.0.0",
    "jsdom": "^25.0.0",
    "lucide-static": "1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
